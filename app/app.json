{
  "expo": {
    "name": "Miranda Glow",
    "slug": "miranda-glow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mirandaglow",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C12"
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/app",
      "typedRoutes": false
    }
  }
}
