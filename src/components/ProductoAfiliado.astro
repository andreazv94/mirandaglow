---
// ============================================================
//  TARJETA DE PRODUCTO AFILIADO
// ============================================================
//  Úsalo así dentro de cualquier artículo .mdx:
//     import ProductoAfiliado from '../../components/ProductoAfiliado.astro';
//     <ProductoAfiliado id="vitC" />
//
//  - Pone automáticamente rel="sponsored nofollow" (lo exige Google
//    para enlaces de afiliado; si no lo pones, te puede penalizar).
//  - target="_blank" para que no pierdas la visita de tu web.
//  - Si cambias el enlace en productos.ts, se actualiza en todos lados.
// ============================================================
import { getProducto } from '../data/productos';

interface Props { id: string; }
const { id } = Astro.props;
const p = getProducto(id);
---
{p ? (
  <a
    class="prod-card"
    href={p.url}
    target="_blank"
    rel="sponsored nofollow noopener"
  >
    <span class="prod-body">
      <span class="prod-cat">{p.categoria}{p.natural && <span class="prod-nat">natural</span>}</span>
      <span class="prod-name">{p.nombre}</span>
      <span class="prod-desc">{p.descripcion}</span>
    </span>
    <span class="prod-side">
      <span class="prod-price">{p.precio}</span>
      <span class="prod-cta">Ver en {p.tienda}</span>
    </span>
  </a>
) : (
  <span style="color:#c00">[Producto «{id}» no encontrado en productos.ts]</span>
)}

<style>
  .prod-card{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;font-family:var(--font-ui);
    background:var(--white);border:1px solid var(--line);border-left:3px solid var(--lila);border-radius:var(--radius);
    padding:16px 20px;margin:22px 0;text-decoration:none;color:var(--ink)}
  .prod-card:hover{border-color:var(--ink);border-left-color:var(--lila)}
  .prod-cat{display:block;font-size:.85rem;color:var(--ink-soft)}
  .prod-nat{margin-left:8px;color:var(--salvia)}
  .prod-name{display:block;font-weight:600;font-size:1.08rem;margin:2px 0}
  .prod-desc{display:block;font-size:.93rem;color:var(--ink-soft);line-height:1.45}
  .prod-side{text-align:right;white-space:nowrap}
  .prod-price{display:block;font-weight:600}
  .prod-cta{display:block;font-size:.88rem;color:var(--lila);margin-top:2px}
  @media(max-width:640px){.prod-card{grid-template-columns:1fr}.prod-side{text-align:left}}
</style>
