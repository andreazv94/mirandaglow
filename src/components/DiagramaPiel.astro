---
// Ilustración propia de las capas de la piel (sin derechos de terceros).
// modo="capas": anatomía con etiquetas.
// modo="absorcion": añade hasta dónde llega cada tipo de ingrediente.
interface Props { modo?: 'capas' | 'absorcion' }
const { modo = 'capas' } = Astro.props;
const abs = modo === 'absorcion';

// Células de grasa de la hipodermis
const grasa: [number, number, number][] = [];
for (let row = 0; row < 3; row++)
  for (let i = 0; i < 12; i++)
    grasa.push([60 + i * 52 + (row % 2 ? 26 : 0), 420 + row * 38, 22 + ((i * 7 + row * 3) % 5)]);
// Ladrillos del estrato córneo
const ladrillos: [number, number][] = [];
for (let row = 0; row < 2; row++) for (let i = 0; i < 22; i++) ladrillos.push([40 + i * 28 + (row ? 14 : 0), 62 + row * 8]);
// Células de la epidermis viva
const celulas: [number, number][] = [];
for (let row = 0; row < 4; row++) for (let i = 0; i < 26; i++) celulas.push([46 + i * 24 + (row % 2 ? 12 : 0), 88 + row * 15]);
---
<figure class={`diag${abs ? ' abs' : ''}`}>
  <svg viewBox={abs ? '0 0 960 560' : '0 0 960 540'} role="img" aria-labelledby="dg-t dg-d">
    <title id="dg-t">{abs ? 'Hasta dónde llegan los ingredientes de la piel' : 'Las capas de la piel'}</title>
    <desc id="dg-d">Corte de la piel con la epidermis (estrato córneo y capa viva), la dermis con colágeno, vasos, folículo, glándula sebácea y sudorípara, y la hipodermis con células de grasa.</desc>

    <!-- Hipodermis -->
    <rect x="30" y="380" width="640" height="150" fill="#FBF3E6" />
    {grasa.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#FCEBD0" stroke="#E9CFA6" stroke-width="1.5" />)}

    <!-- Dermis -->
    <rect x="30" y="150" width="640" height="232" fill="#F8E9EC" />
    {[170, 205, 240, 275, 310, 345].map((y, i) => (
      <path d={`M30 ${y} C 120 ${y - 12}, 200 ${y + 12}, 290 ${y} S 460 ${y - 10}, 560 ${y + 4} S 640 ${y - 6}, 670 ${y}`} fill="none" stroke="#E7C3CD" stroke-width={i % 2 ? 2 : 3} opacity=".9" />
    ))}
    <!-- Vasos sanguíneos -->
    <path d="M30 330 C 150 300, 250 360, 380 320 S 560 300, 670 330" fill="none" stroke="#D86A7C" stroke-width="5" stroke-linecap="round" />
    <path d="M30 345 C 160 318, 260 375, 390 336 S 560 318, 670 346" fill="none" stroke="#7A9BC9" stroke-width="5" stroke-linecap="round" />
    <path d="M200 340 C 205 260, 180 200, 210 158" fill="none" stroke="#D86A7C" stroke-width="2.5" />
    <path d="M470 318 C 480 250, 455 200, 480 158" fill="none" stroke="#D86A7C" stroke-width="2.5" />

    <!-- Glándula sudorípara y conducto -->
    <path d="M560 160 C 555 220, 575 280, 562 330" fill="none" stroke="#7FBFC7" stroke-width="3" />
    <path d="M562 330 c -18 4 -22 22 -4 26 c 18 4 24 -14 6 -20 c -16 -4 -24 14 -6 22 c 16 6 26 -10 10 -18" fill="none" stroke="#5FB6C4" stroke-width="4" />
    <path d="M560 60 L 560 150" fill="none" stroke="#7FBFC7" stroke-width="3" stroke-dasharray="3 3" />

    <!-- Folículo y pelo -->
    <path d="M318 58 C 322 140, 318 250, 330 352" fill="none" stroke="#C9A99A" stroke-width="16" stroke-linecap="round" opacity=".55" />
    <path d="M320 -10 C 316 20, 318 40, 318 60 C 320 150, 318 250, 328 350" fill="none" stroke="#6B4F43" stroke-width="4" stroke-linecap="round" />
    <ellipse cx="330" cy="358" rx="16" ry="12" fill="#C9A99A" />
    <!-- Glándula sebácea -->
    <path d="M330 190 c 18 -6 36 2 38 18 c 2 18 -16 26 -30 20 c -6 -3 -8 -8 -8 -12" fill="#F4D58D" stroke="#E2B95A" stroke-width="2" />

    <!-- Epidermis viva -->
    <rect x="30" y="78" width="640" height="74" fill="#F3D3DC" />
    {celulas.map(([x, y]) => <rect x={x - 9} y={y - 5} width="18" height="11" rx="5" fill="#F9E4EA" stroke="#E7B9C6" stroke-width="1" />)}
    <!-- Melanocitos (capa basal) -->
    {[70, 150, 250, 400, 520, 610].map((x) => <circle cx={x} cy="146" r="5" fill="#8C5E4C" />)}
    <!-- Estrato córneo: ladrillos y cemento -->
    <rect x="30" y="58" width="640" height="20" fill="#EBC4CF" />
    {ladrillos.map(([x, y]) => <rect x={x - 12} y={y - 3} width="24" height="6" rx="1" fill="#F7E2E8" stroke="#D9A6B5" stroke-width=".8" />)}
    <line x1="30" y1="58" x2="670" y2="58" stroke="#C98EA0" stroke-width="1.5" />

    <!-- Etiquetas -->
    <g class="lbl">
      <text x="690" y="70">Estrato córneo</text>
      <text x="690" y="86" class="s">la barrera: «ladrillos y cemento»</text>
      <text x="690" y="118">Epidermis</text>
      <text x="690" y="134" class="s">se renueva cada ~4 semanas</text>
      <text x="690" y="152" class="s">melanocitos: fabrican el pigmento</text>
      <text x="690" y="252">Dermis</text>
      <text x="690" y="268" class="s">colágeno y elastina: firmeza</text>
      <text x="690" y="284" class="s">vasos, glándulas y raíz del pelo</text>
      <text x="690" y="450">Hipodermis</text>
      <text x="690" y="466" class="s">grasa: amortigua y da volumen</text>
    </g>
    {!abs && (
      <g class="lbl s">
        <line x1="368" y1="205" x2="420" y2="205" class="ld" /><text x="424" y="209">glándula sebácea (grasa)</text>
        <line x1="336" y1="358" x2="380" y2="380" class="ld" /><text x="384" y="392">folículo del pelo</text>
        <line x1="580" y1="345" x2="610" y2="372" class="ld" /><text x="560" y="392">glándula del sudor</text>
        <line x1="250" y1="330" x2="250" y2="368" class="ld" /><text x="120" y="378">vasos sanguíneos</text>
      </g>
    )}

    <!-- Absorción -->
    {abs && (
      <g class="abs-g">
        <rect x="30" y="0" width="640" height="56" fill="#fff" opacity=".0" />
        <g transform="translate(46 0)">
          <line x1="0" y1="14" x2="0" y2="54" class="ar" /><polygon points="-6,48 6,48 0,58" class="ah" />
          <text x="10" y="22" class="t">Protector solar</text>
          <text x="10" y="36" class="t">y siliconas</text>
        </g>
        <g transform="translate(176 0)">
          <line x1="0" y1="14" x2="0" y2="72" class="ar" /><polygon points="-6,66 6,66 0,76" class="ah" />
          <text x="10" y="22" class="t">Ceramidas, aceites,</text>
          <text x="10" y="36" class="t">glicerina</text>
        </g>
        <g transform="translate(430 0)">
          <line x1="0" y1="14" x2="0" y2="140" class="ar" /><polygon points="-6,134 6,134 0,144" class="ah" />
          <text x="10" y="22" class="t">Niacinamida, vitamina C,</text>
          <text x="10" y="36" class="t">ácidos, retinol</text>
        </g>
        <g transform="translate(470 0)">
          <line x1="-40" y1="146" x2="-40" y2="210" class="ar dash" /><polygon points="-46,204 -34,204 -40,214" class="ah" />
          <text x="-30" y="196" class="t">el retinol «avisa» a la dermis</text>
        </g>
        <g transform="translate(600 0)">
          <text x="-6" y="22" class="t x">Colágeno en crema:</text>
          <text x="-6" y="36" class="t x">no entra</text>
          <line x1="20" y1="44" x2="36" y2="56" class="xx" /><line x1="36" y1="44" x2="20" y2="56" class="xx" />
        </g>
      </g>
    )}
  </svg>
  <figcaption>
    {abs
      ? 'Hasta dónde llega cada tipo de ingrediente. La mayoría de los cosméticos actúan en la epidermis; para llegar a la dermis hacen falta tratamientos médicos.'
      : 'Corte de la piel. Los cosméticos actúan sobre todo en la epidermis, la capa de arriba.'}
  </figcaption>
</figure>

<style>
  .diag{margin:36px 0 40px}
  .diag svg{width:100%;height:auto;display:block;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 6px}
  .lbl text{font-family:var(--sans);font-size:15px;font-weight:600;fill:var(--ink)}
  .lbl text.s,.lbl.s text{font-size:12.5px;font-weight:400;fill:#5F7376}
  .ld{stroke:#5F7376;stroke-width:1}
  .ar{stroke:var(--teal);stroke-width:2.5}
  .ar.dash{stroke-dasharray:5 4}
  .ah{fill:var(--teal)}
  .t{font-family:var(--sans);font-size:12.5px;fill:var(--ink);font-weight:500}
  .t.x{fill:#A3485E}
  .xx{stroke:#A3485E;stroke-width:3}
  figcaption{font-size:.9rem;color:var(--ink-soft);margin-top:10px;font-family:var(--sans)}
</style>
