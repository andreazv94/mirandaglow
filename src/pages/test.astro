---
import Layout from '../layouts/Layout.astro';
import Quiz from '../components/Quiz.tsx';
---
<Layout title="Test de piel — Miranda Glow" description="Haz el test y descubre tu rutina de skincare personalizada según tu piel, tu edad y tu momento hormonal.">
  <section class="test-wrap wrap">
    <!-- client:load = el quiz se hidrata en el navegador (es interactivo).
         El resto de la web sigue siendo HTML estático y rápido. -->
    <Quiz client:load />
  </section>
</Layout>

<style>
  .test-wrap{padding-top:56px;padding-bottom:72px}
</style>
