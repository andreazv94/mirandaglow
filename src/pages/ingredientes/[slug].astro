---
import Layout from '../../layouts/Layout.astro';
import ProductoAfiliado from '../../components/ProductoAfiliado.astro';
import { fichas, fichaPorSlug } from '../../data/fichas';
import { buscar } from '../../data/ingredientes';

export function getStaticPaths() {
  return fichas.map((f) => ({ params: { slug: f.slug } }));
}

const f = fichaPorSlug(Astro.params.slug!)!;
const ings = f.inci.map((n) => buscar(n)).filter(Boolean);
const embarazo = ings.some((i) => i!.embarazo === 'evitar') ? 'evitar' : ings.some((i) => i!.embarazo === 'consultar') ? 'consultar' : null;
const rel = (f.relacionados || []).map(fichaPorSlug).filter(Boolean);
const titulo = `${f.nombre}: qué es, para qué sirve y cómo usarlo — Miranda Glow`;
---
<Layout title={titulo} description={f.resumen}>
  <article class="ficha wrap">
    <a class="volver" href="/ingredientes/todos">Todos los ingredientes</a>
    <header>
      <h1>{f.nombre}</h1>
      <p class="inci">En la etiqueta: {f.inci.join(', ')}</p>
      <p class="resumen">{f.resumen}</p>
    </header>

    <div class="vistazo" aria-label="De un vistazo">
      <div><h2>Para qué</h2><p>{f.paraQue.slice(0, 2).join(' ')}</p></div>
      <div><h2>Cuándo</h2><p>{f.comoUsar[0]}</p></div>
      {f.combinaBien && <div><h2>Combina con</h2><p>{f.combinaBien.slice(0, 3).join(', ')}</p></div>}
      <div class={embarazo || f.conCuidado ? 'ojo' : ''}><h2>Ojo</h2><p>{
        embarazo === 'evitar' ? 'No se usa en el embarazo ni en la lactancia.'
        : embarazo === 'consultar' ? 'En el embarazo, consúltalo antes.'
        : f.conCuidado?.[0] ?? f.precauciones?.[0] ?? 'Suele tolerarse bien.'
      }</p></div>
    </div>


    <div class="cuerpo">
      <section>
        <h2>Para qué sirve</h2>
        <ul>{f.paraQue.map((x) => <li>{x}</li>)}</ul>
      </section>

      <section>
        <h2>Cómo usarlo</h2>
        <ul>{f.comoUsar.map((x) => <li>{x}</li>)}</ul>
        {f.concentracion && <p class="conc"><strong>Concentración habitual.</strong> {f.concentracion}</p>}
      </section>

      {(f.combinaBien || f.conCuidado) && (
        <section class="combos">
          {f.combinaBien && <div><h3>Combina bien con</h3><ul>{f.combinaBien.map((x) => <li>{x}</li>)}</ul></div>}
          {f.conCuidado && <div><h3>Con cuidado</h3><ul>{f.conCuidado.map((x) => <li>{x}</li>)}</ul></div>}
        </section>
      )}

      {f.precauciones && (
        <section>
          <h2>Ten en cuenta</h2>
          <ul>{f.precauciones.map((x) => <li>{x}</li>)}</ul>
        </section>
      )}

      {f.mito && (
        <section class="mito">
          <p class="dicen">Se dice: «{f.mito.dicen}»</p>
          <p>{f.mito.realidad}</p>
        </section>
      )}

      {f.productos && f.productos.length > 0 && (
        <section>
          <h2>Productos que lo llevan</h2>
          {f.productos.map((id) => <ProductoAfiliado id={id} />)}
        </section>
      )}
    </div>

    <aside class="cta">
      <h3>¿Lo lleva tu crema?</h3>
      <p>Pega la lista de ingredientes de tu producto y te decimos qué lleva y qué conviene vigilar.</p>
      <a class="btn" href="/ingredientes">Abrir el lector de ingredientes</a>
    </aside>

    {rel.length > 0 && (
      <nav class="rel" aria-label="Ingredientes relacionados">
        <h2>Relacionados</h2>
        <ul>{rel.map((r) => <li><a href={`/ingredientes/${r!.slug}`}><span>{r!.nombre}</span><small>{r!.resumen.split('. ')[0]}.</small></a></li>)}</ul>
      </nav>
    )}

    <p class="nota">Información general sobre cosmética. No sustituye la consulta con una dermatóloga o tu farmacéutica.</p>
  </article>
</Layout>

<style>
  .ficha{max-width:780px;padding-top:56px;padding-bottom:96px}
  .volver{display:inline-block;font-size:.9rem;color:var(--ink-soft);margin-bottom:28px}
  header h1{margin-bottom:14px}
  .inci{font-size:.9rem;color:var(--ink-soft);margin-bottom:22px}
  .resumen{font-family:var(--serif);font-size:1.4rem;line-height:1.5;font-weight:300;color:var(--ink)}
  .emb{margin-top:28px;padding:14px 18px;border-radius:12px;font-size:.97rem}
  .emb-evitar{background:#FBF1E4;color:var(--ambar);border:1px solid #EBD2AE}
  .emb-consultar{background:var(--blush);color:#7B4655;border:1px solid #EDD3D9}
  .vistazo{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:32px}
  .vistazo div{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:16px 18px}
  .vistazo h2{font-family:var(--sans);font-size:.85rem;font-weight:700;color:var(--teal);margin-bottom:6px;letter-spacing:0}
  .vistazo p{font-size:.95rem;line-height:1.45;color:var(--ink)}
  .vistazo .ojo{background:#FBF1E4;border-color:#EBD2AE}
  .vistazo .ojo h2{color:var(--ambar)}
  .cuerpo{margin-top:24px}
  section{padding:32px 0;border-bottom:1px solid var(--line)}
  section h2{font-size:1.8rem;margin-bottom:16px}
  section h3{font-family:var(--sans);font-weight:600;font-size:1rem;margin-bottom:10px}
  ul{list-style:none}
  li{position:relative;padding-left:22px;margin-bottom:10px;font-family:var(--serif);font-size:1.12rem;line-height:1.6;color:#33494D}
  li::before{content:'';position:absolute;left:2px;top:.72em;width:7px;height:7px;border-radius:50%;background:var(--aqua)}
  .conc{margin-top:18px;background:var(--white);border:1px solid var(--line);border-radius:12px;padding:16px 18px;font-size:.98rem;color:var(--ink-soft)}
  .conc strong{color:var(--ink)}
  .combos{display:grid;grid-template-columns:1fr 1fr;gap:32px}
  .combos li{font-size:1.02rem}
  .mito{border:none;background:var(--mist);border-radius:18px;padding:28px;margin:32px 0}
  .mito .dicen{font-family:var(--serif);font-style:italic;font-size:1.3rem;margin-bottom:10px}
  .mito p{color:#33494D}
  .cta{margin-top:48px;background:var(--ink);color:#E6F0F1;border-radius:18px;padding:32px}
  .cta h3{font-size:1.8rem;margin-bottom:8px;color:#fff}
  .cta p{color:#B9CDD0;margin-bottom:20px}
  .cta .btn{background:var(--aqua);border-color:var(--aqua);color:var(--ink)}
  .cta .btn:hover{background:#fff;border-color:#fff}
  .rel{margin-top:56px}
  .rel h2{font-size:1.8rem;margin-bottom:12px}
  .rel ul{border-top:1px solid var(--line)}
  .rel li{padding:0;margin:0}
  .rel li::before{display:none}
  .rel a{display:grid;grid-template-columns:200px 1fr;gap:18px;padding:16px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);font-family:var(--sans);font-size:.95rem}
  .rel a span{font-family:var(--serif);font-size:1.25rem}
  .rel a small{color:var(--ink-soft);font-size:.92rem}
  .rel a:hover span{color:var(--teal)}
  .nota{margin-top:40px;font-size:.85rem;color:var(--ink-soft)}
  @media(max-width:700px){.combos{grid-template-columns:1fr;gap:12px}.rel a{grid-template-columns:1fr;gap:2px}}
</style>
