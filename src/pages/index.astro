---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guias = (await getCollection('blog'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 5);

// Ejemplo de la portada: un sérum inventado (no es una marca real) para
// enseñar cómo se lee una lista de ingredientes.
type Ing = { n: string; t?: 'base' | 'activo' | 'ojo' | 'anuncio' };
const inci: Ing[] = [
  { n: 'Aqua', t: 'base' }, { n: 'Glycerin' }, { n: 'Niacinamide', t: 'activo' }, { n: 'Butylene Glycol' },
  { n: 'Propanediol' }, { n: 'Sodium Hyaluronate', t: 'activo' }, { n: 'Panthenol' }, { n: 'Phenoxyethanol' },
  { n: 'Carbomer' }, { n: 'Sodium Hydroxide' }, { n: 'Parfum', t: 'ojo' }, { n: 'Rosa Canina Fruit Oil', t: 'anuncio' },
  { n: 'Ethylhexylglycerin' }, { n: 'Linalool', t: 'ojo' }, { n: 'Limonene', t: 'ojo' },
];
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Lee lo que lleva tu crema, no lo que promete.</h1>
      <p class="lead">
        Te ayudamos a montar tu rutina de cuidado de la piel según los ingredientes de cada
        producto. Sin marcas que paguen por salir y sin influencers. Gratis y sin registro.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/test">Hacer el test de piel</a>
        <a class="btn ghost" href="/blog">Leer las guías</a>
      </div>
      <p class="hero-note">El test tarda unos dos minutos y vale para cualquier piel y cualquier edad.</p>
    </div>

    <figure class="label" aria-labelledby="label-cap">
      <div class="label-front">
        <span class="label-k">Delante del bote</span>
        <p class="label-claim">«Sérum iluminador con aceite de rosa mosqueta»</p>
      </div>
      <div class="label-back">
        <span class="label-k">Detrás, en la lista de ingredientes</span>
        <p class="inci">
          {inci.map((i, n) => (
            <>
              {i.t ? <mark class={`m-${i.t}`}>{i.n}</mark> : <span>{i.n}</span>}{n < inci.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </div>
      <dl class="notes">
        <div><dt><mark class="m-base">Aqua</mark></dt><dd>Agua. Es casi todo el bote.</dd></div>
        <div><dt><mark class="m-activo">Niacinamide · Sodium Hyaluronate</mark></dt><dd>Los que hacen algo: niacinamida para brillos y manchas, hialurónico para hidratar. Van arriba, así que hay buena cantidad.</dd></div>
        <div><dt><mark class="m-anuncio">Rosa Canina Fruit Oil</mark></dt><dd>La rosa mosqueta del anuncio. Va detrás del perfume: hay muy poca.</dd></div>
        <div><dt><mark class="m-ojo">Parfum · Linalool · Limonene</mark></dt><dd>Perfume y sus alérgenos. Si tu piel es sensible, mejor sin él.</dd></div>
      </dl>
      <figcaption id="label-cap">
        Los ingredientes van de más a menos cantidad hasta llegar al 1&nbsp;%. Producto de ejemplo, no es una marca real.
      </figcaption>
    </figure>
  </section>

  <section class="how wrap" aria-labelledby="how-h">
    <h2 id="how-h">Cómo funciona</h2>
    <ol class="how-list">
      <li><h3>Respondes unas diez preguntas</h3><p>Tu tipo de piel, lo que quieres mejorar, tu edad y, si quieres, tu momento hormonal: ciclo, embarazo o menopausia.</p></li>
      <li><h3>Recibes tu rutina de mañana y noche</h3><p>Pocos productos, en orden y con el motivo de cada uno. Si algo no te conviene, como el retinol en el embarazo, lo quitamos.</p></li>
      <li><h3>La sigues cada día en la app</h3><p>Marca los pasos, mira qué activo toca esta noche y lleva la cuenta de tu constancia.</p></li>
    </ol>
  </section>

  <section class="rules" aria-labelledby="rules-h">
    <div class="wrap rules-in">
      <div class="rules-head">
        <h2 id="rules-h">Nuestras reglas</h2>
        <p>Queremos que puedas fiarte de lo que lees aquí. Estas son las normas que seguimos con cada guía y cada recomendación.</p>
      </div>
      <ul class="rules-list">
        <li><h3>Ninguna marca paga por aparecer</h3><p>No hacemos publicaciones patrocinadas ni aceptamos productos a cambio de hablar bien de ellos.</p></li>
        <li><h3>Recomendamos por ingredientes</h3><p>Miramos qué lleva cada producto y si hay estudios que lo respalden, no quién lo anuncia ni lo que está de moda.</p></li>
        <li><h3>Te decimos cuándo ir al médico</h3><p>Rosácea, acné fuerte, melasma o un lunar que cambia necesitan una dermatóloga, no una crema. Lo avisamos siempre.</p></li>
        <li><h3>Te contamos cómo ganamos dinero</h3><p>Algunos enlaces a tiendas son de afiliación. Si compras, nos llevamos una comisión pequeña y a ti no te cuesta más.</p></li>
      </ul>
    </div>
  </section>

  <section class="guides wrap" aria-labelledby="guides-h">
    <div class="guides-head">
      <h2 id="guides-h">Guías recientes</h2>
      <a href="/blog">Ver todas las guías</a>
    </div>
    <ul class="guide-list">
      {guias.map((g) => (
        <li>
          <a href={`/blog/${g.slug}`}>
            <span class="g-topic">{g.data.concern}</span>
            <span class="g-title">{g.data.titulo}</span>
            <span class="g-desc">{g.data.descripcion}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap">
    <div class="app-band">
      <div>
        <h2>Tu rutina, cada día</h2>
        <p>Marca los pasos de la mañana y la noche, haz la rutina guiada y mira qué activo te toca hoy. Funciona en el navegador del móvil, sin instalar nada. Tus datos se quedan en tu teléfono.</p>
      </div>
      <a class="btn app-btn" href="/app/">Abrir la app</a>
    </div>
  </section>
</Layout>

<style>
  .hero{display:grid;grid-template-columns:1fr 1.05fr;gap:64px;align-items:start;padding-top:72px;padding-bottom:96px}
  .hero h1{max-width:13ch;margin-bottom:24px}
  .lead{font-family:var(--font-read);font-size:1.22rem;line-height:1.6;color:var(--ink-soft);max-width:44ch;margin-bottom:32px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .hero-note{margin-top:18px;font-size:.9rem;color:var(--ink-soft)}

  /* La etiqueta: el elemento protagonista */
  .label{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:28px 30px 24px}
  .label-k{display:block;font-size:.85rem;color:var(--ink-soft);margin-bottom:6px}
  .label-front{padding-bottom:18px;border-bottom:1px dashed var(--line);margin-bottom:18px}
  .label-claim{font-family:var(--font-read);font-size:1.35rem;line-height:1.3}
  .inci{font-size:.98rem;line-height:1.85;color:var(--ink-soft)}
  mark{background:none;color:var(--ink);padding:1px 2px;border-radius:2px}
  .inci mark{white-space:nowrap}
  .m-base{box-shadow:inset 0 -.45em 0 #E3E5E9}
  .m-activo{box-shadow:inset 0 -.45em 0 #CFE6DC}
  .m-ojo{box-shadow:inset 0 -.45em 0 #F3DFC2}
  .m-anuncio{box-shadow:inset 0 -.45em 0 var(--acento-tint);outline:1.5px solid var(--acento);outline-offset:1px}
  .notes{margin-top:22px;display:grid;gap:12px}
  .notes div{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr);gap:14px;font-size:.92rem;line-height:1.45}
  .notes dt{font-weight:600}
  .notes dd{color:var(--ink-soft)}
  .label figcaption{margin-top:20px;padding-top:14px;border-top:1px solid var(--line);font-size:.82rem;color:var(--ink-soft)}

  .how{padding-bottom:96px}
  .how h2{margin-bottom:32px}
  .how-list{list-style:none;counter-reset:paso;display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
  .how-list li{counter-increment:paso;border-top:2px solid var(--ink);padding-top:18px}
  .how-list li::before{content:counter(paso) ".";display:block;font-weight:700;color:var(--acento);margin-bottom:8px}
  .how-list h3{margin-bottom:8px}
  .how-list p{color:var(--ink-soft);font-size:.98rem}

  .rules{background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:88px 0}
  .rules-in{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px}
  .rules-head p{font-family:var(--font-read);font-size:1.12rem;color:var(--ink-soft);margin-top:16px;max-width:36ch;line-height:1.6}
  .rules-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:36px 40px}
  .rules-list h3{margin-bottom:8px}
  .rules-list p{color:var(--ink-soft);font-size:.98rem}

  .guides{padding:96px 28px 72px}
  .guides-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:20px}
  .guides-head a{font-weight:600;text-decoration:none}
  .guides-head a:hover{text-decoration:underline}
  .guide-list{list-style:none;border-top:1px solid var(--line)}
  .guide-list a{display:grid;grid-template-columns:150px 1fr 1.1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);align-items:baseline}
  .guide-list a:hover .g-title{color:var(--acento)}
  .g-topic{font-size:.9rem;color:var(--ink-soft)}
  .g-title{font-weight:600;font-size:1.08rem;line-height:1.35}
  .g-desc{font-family:var(--font-read);color:var(--ink-soft);font-size:1rem;line-height:1.5}

  .app-band{display:flex;gap:40px;align-items:center;justify-content:space-between;background:var(--ink);color:#F0F6F7;border-radius:var(--radius);padding:48px}
  .app-band h2{margin-bottom:12px}
  .app-band p{color:#C3D6D9;max-width:58ch}
  .app-btn{background:#A9D8DC;border-color:#A9D8DC;color:var(--ink);white-space:nowrap}
  .app-btn:hover{background:#fff;border-color:#fff}

  @media(max-width:900px){
    .hero{grid-template-columns:1fr;gap:40px;padding-top:44px}
    .how-list,.rules-list,.rules-in{grid-template-columns:1fr;gap:28px}
    .guide-list a{grid-template-columns:1fr;gap:4px}
    .app-band{flex-direction:column;align-items:flex-start;padding:32px 24px}
    .notes div{grid-template-columns:1fr;gap:2px}
    .label{padding:22px 20px}
  }
</style>
