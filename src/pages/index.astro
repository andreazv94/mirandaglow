---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PielHoy from '../components/PielHoy.tsx';
import { inicio } from '../lib/seo';

const guias = (await getCollection('blog'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 4);

// Ejemplo inventado (no es una marca real) para enseñar a leer una etiqueta.
type Ing = { n: string; t?: 'base' | 'activo' | 'ojo' | 'anuncio' };
const inci: Ing[] = [
  { n: 'Aqua', t: 'base' }, { n: 'Glycerin' }, { n: 'Niacinamide', t: 'activo' }, { n: 'Butylene Glycol' },
  { n: 'Propanediol' }, { n: 'Sodium Hyaluronate', t: 'activo' }, { n: 'Panthenol' }, { n: 'Phenoxyethanol' },
  { n: 'Carbomer' }, { n: 'Sodium Hydroxide' }, { n: 'Parfum', t: 'ojo' }, { n: 'Rosa Canina Fruit Oil', t: 'anuncio' },
  { n: 'Ethylhexylglycerin' }, { n: 'Linalool', t: 'ojo' }, { n: 'Limonene', t: 'ojo' },
];
---
<Layout overlay jsonld={inicio()}>
  <!-- Portada: la foto manda -->
  <section class="hero">
    <img class="hero-img" src="/img/frasco.jpg" alt="Frasco de sérum sin etiqueta sobre una piedra clara, con gotas alrededor" />
    <div class="hero-in wrap">
      <div class="hero-copy">
        <h1>Lee la etiqueta,<br />no el anuncio.</h1>
        <p>Cuidado de la piel explicado por ingredientes. Sin marcas que paguen por salir y sin influencers.</p>
        <div class="hero-cta">
          <a class="btn" href="/test">Hacer el test de piel</a>
          <a class="btn ghost" href="/guia">Leer la guía de la piel</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Declaración -->
  <section class="manifesto wrap">
    <p>
      Miranda Glow nace para que elijas tu rutina sabiendo lo que te pones en la cara.
      Miramos qué lleva cada producto y si hay estudios detrás. Ni modas, ni promesas milagro,
      ni contenido patrocinado.
    </p>
  </section>

  <!-- Tu piel hoy: consejos según el tiempo -->
  <section class="hoy" id="piel-hoy">
    <div class="wrap hoy-in">
      <h2>Tu piel hoy</h2>
      <PielHoy client:visible />
    </div>
  </section>

  <!-- Cómo leer una etiqueta -->
  <section class="leer">
    <div class="wrap leer-in">
      <figure class="leer-img">
        <img src="/img/textura.jpg" alt="Textura de sérum transparente en primer plano" loading="lazy" />
      </figure>
      <div class="leer-copy">
        <h2>Lo que pone delante y lo que lleva detrás</h2>
        <p class="claim"><span>Delante</span>«Sérum iluminador con aceite de rosa mosqueta»</p>
        <p class="inci" aria-label="Lista de ingredientes">
          <span class="inci-k">Detrás</span>
          {inci.map((i, n) => (
            <>{i.t ? <mark class={`m-${i.t}`}>{i.n}</mark> : <span>{i.n}</span>}{n < inci.length - 1 ? ', ' : '.'}</>
          ))}
        </p>
        <dl class="notes">
          <div><dt><i class="dot d-base"></i>Agua</dt><dd>Casi todo el bote.</dd></div>
          <div><dt><i class="dot d-activo"></i>Niacinamida e hialurónico</dt><dd>Lo que funciona. Van arriba: hay buena cantidad.</dd></div>
          <div><dt><i class="dot d-anuncio"></i>Rosa mosqueta</dt><dd>La del anuncio. Va detrás del perfume: hay muy poca.</dd></div>
          <div><dt><i class="dot d-ojo"></i>Perfume y alérgenos</dt><dd>Si tu piel es sensible, mejor sin ellos.</dd></div>
        </dl>
        <p class="small">Los ingredientes van de más a menos cantidad hasta el 1&nbsp;%. Producto de ejemplo, no es una marca real.</p>
        <a class="btn leer-btn" href="/ingredientes">Analizar un producto</a>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="pasos wrap">
    <div class="pasos-copy">
      <h2>Tu rutina, en tres pasos</h2>
      <ol>
        <li><h3>Cuéntanos tu piel</h3><p>Unas diez preguntas: tipo de piel, qué quieres mejorar, tu edad y, si quieres, tu ciclo, embarazo o menopausia.</p></li>
        <li><h3>Recibe tu rutina</h3><p>Mañana y noche, en orden y con el porqué de cada producto. Si algo no te conviene, no aparece.</p></li>
        <li><h3>Síguela cada día</h3><p>En la app marcas los pasos y ves qué activo te toca esa noche.</p></li>
      </ol>
      <a class="btn" href="/test">Empezar el test</a>
    </div>
    <figure class="pasos-img">
      <img src="/img/mano.jpg" alt="Gota de sérum sobre el dorso de una mano" loading="lazy" />
    </figure>
  </section>

  <!-- Reglas -->
  <section class="reglas">
    <div class="wrap">
      <h2>Nuestras reglas</h2>
      <ul>
        <li><h3>Ninguna marca paga por salir</h3><p>No hacemos contenido patrocinado ni aceptamos productos a cambio de reseñas.</p></li>
        <li><h3>Ingredientes antes que marcas</h3><p>Si hay una opción más barata que hace lo mismo, te la decimos.</p></li>
        <li><h3>Cuándo ir al médico</h3><p>Rosácea, acné fuerte, melasma o un lunar que cambia necesitan una dermatóloga. Lo avisamos.</p></li>
        <li><h3>Sin promesas milagro</h3><p>Nada de fotos de antes y después ni resultados en días. La piel tarda semanas en cambiar y así lo contamos.</p></li>
      </ul>
    </div>
  </section>

  <!-- Guías -->
  <section class="guias wrap">
    <div class="guias-head">
      <h2>Guías</h2>
      <a href="/guia">Ver la guía completa</a>
    </div>
    <ul>
      {guias.map((g) => (
        <li>
          <a href={`/blog/${g.slug}`}>
            <span class="g-tema">{g.data.concern}</span>
            <span class="g-tit">{g.data.titulo}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- App -->
  <section class="app">
    <img src="/img/crema.jpg" alt="Crema facial extendida sobre fondo rosa y turquesa" loading="lazy" />
    <div class="app-card">
      <h2>Tu rutina, cada día</h2>
      <p>Marca los pasos, sigue la rutina guiada y mira qué activo te toca esta noche. Sin instalar nada: tus datos se quedan en tu móvil.</p>
      <a class="btn" href="/app/">Abrir la app</a>
    </div>
  </section>
</Layout>

<style>
  /* Portada */
  .hero{position:relative;min-height:min(92vh,860px);display:flex;align-items:center;overflow:hidden;background:var(--mist)}
  .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:30% 50%;animation:revela 1.6s cubic-bezier(.2,.7,.2,1) both}
  @keyframes revela{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:none}}
  .hero-in{position:relative;width:100%;display:flex;justify-content:flex-end;padding-top:76px}
  .hero-copy{max-width:540px;padding:40px 0}
  .hero h1{margin-bottom:24px}
  .hero p{font-size:1.12rem;max-width:36ch;margin-bottom:34px;color:var(--ink)}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .hero .btn.ghost{background:rgba(255,255,255,.55);backdrop-filter:blur(6px)}

  .manifesto{padding:120px 32px}
  .manifesto p{font-family:var(--serif);font-weight:300;font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.3;max-width:28ch;letter-spacing:-.01em;font-variation-settings:"opsz" 48}


  /* Tu piel hoy */
  .hoy{background:var(--mist);padding:96px 0}
  .hoy-in{display:grid;grid-template-columns:.7fr 1.3fr;gap:64px;align-items:start}
  :global(.ph-pedir p){color:#3D5458;font-size:1.08rem;max-width:52ch;margin-bottom:22px}
  :global(.ph-acciones){display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  :global(.ph-form){display:flex;gap:8px}
  :global(.ph-form input){font:inherit;padding:13px 18px;border:1px solid rgba(34,54,58,.3);border-radius:999px;background:var(--white);min-width:200px}
  :global(.ph-error){color:var(--ambar)!important;margin-top:16px!important}
  :global(.ph-priv){font-size:.85rem!important;color:var(--ink-soft)!important;margin-top:18px!important}
  :global(.sr){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  :global(.ph-res){display:grid;grid-template-columns:200px 1fr;gap:36px}
  :global(.ph-lugar){font-size:.95rem;color:var(--ink-soft)}
  :global(.ph-temp){font-family:var(--serif);font-weight:300;font-size:4.6rem;line-height:1;margin:6px 0 14px}
  :global(.ph-datos dl){display:grid;gap:6px;font-size:.92rem}
  :global(.ph-datos dl div){display:flex;justify-content:space-between;border-bottom:1px solid rgba(34,54,58,.15);padding-bottom:6px}
  :global(.ph-datos dt){color:var(--ink-soft)}
  :global(.ph-cambiar){margin-top:16px;background:none;border:none;color:var(--teal);text-decoration:underline;cursor:pointer;font:inherit;font-size:.88rem;padding:0}
  :global(.ph-consejos){list-style:none;display:grid;gap:10px}
  :global(.ph-consejos li){background:var(--white);border-radius:14px;padding:18px 22px;border-left:3px solid var(--aqua)}
  :global(.ph-consejos li.ph-alto){border-left-color:var(--ambar)}
  :global(.ph-consejos h3){font-family:var(--sans);font-size:1.02rem;font-weight:600;margin-bottom:4px;letter-spacing:0}
  :global(.ph-consejos p){color:var(--ink-soft);font-size:.95rem}

  /* Etiqueta */
  .leer{background:var(--white)}
  .leer-in{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-top:110px;padding-bottom:110px}
  .leer-img img{width:100%;aspect-ratio:4/5;object-fit:cover}
  .leer h2{margin-bottom:36px;max-width:16ch}
  .claim{font-family:var(--serif);font-size:1.4rem;font-style:italic;padding-bottom:22px;margin-bottom:22px;border-bottom:1px solid var(--line)}
  .claim span,.inci-k{display:block;font-family:var(--sans);font-style:normal;font-size:.85rem;color:var(--ink-soft);margin-bottom:6px}
  .inci{font-size:.98rem;line-height:1.9;color:var(--ink-soft)}
  mark{background:none;color:var(--ink);white-space:nowrap;padding:0 1px}
  .m-base{box-shadow:inset 0 -.42em 0 #E2E8EA}
  .m-activo{box-shadow:inset 0 -.42em 0 #CBE6DA}
  .m-ojo{box-shadow:inset 0 -.42em 0 #F2DEC2}
  .m-anuncio{box-shadow:inset 0 -.42em 0 #F3D3DC}
  .notes{margin:30px 0 22px;display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}
  .notes dt{font-weight:600;font-size:.95rem;display:flex;align-items:center;gap:8px}
  .notes dd{color:var(--ink-soft);font-size:.92rem;margin-top:2px}
  .leer-btn{margin-top:28px}
  .dot{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
  .d-base{background:#D5DDE0}.d-activo{background:#9FD0BB}.d-ojo{background:#E8C38E}.d-anuncio{background:#E9AFC0}

  /* Pasos */
  .pasos{display:grid;grid-template-columns:1.05fr .95fr;gap:80px;align-items:center;padding-top:120px;padding-bottom:120px}
  .pasos h2{margin-bottom:40px}
  .pasos ol{list-style:none;counter-reset:p;margin-bottom:40px}
  .pasos li{counter-increment:p;display:grid;grid-template-columns:52px 1fr;column-gap:8px;padding:22px 0;border-top:1px solid var(--line)}
  .pasos li:last-child{border-bottom:1px solid var(--line)}
  .pasos li::before{content:counter(p);grid-row:span 2;font-family:var(--serif);font-size:1.8rem;font-weight:300;color:var(--teal);line-height:1}
  .pasos li h3{margin-bottom:4px}
  .pasos li p{color:var(--ink-soft)}
  .pasos-img img{width:100%;aspect-ratio:4/5;object-fit:cover}

  /* Reglas */
  .reglas{background:var(--blush);padding:110px 0}
  .reglas h2{margin-bottom:52px}
  .reglas ul{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:36px}
  .reglas li{border-top:1px solid rgba(34,54,58,.25);padding-top:20px}
  .reglas h3{margin-bottom:10px}
  .reglas p{color:#4D5F62;font-size:.97rem}

  /* Guías */
  .guias{padding-top:110px;padding-bottom:110px}
  .guias-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:28px}
  .guias-head a{color:var(--ink);font-size:.95rem}
  .guias ul{list-style:none;border-top:1px solid var(--line)}
  .guias li a{display:grid;grid-template-columns:200px 1fr;gap:24px;align-items:baseline;padding:26px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}
  .g-tema{font-size:.9rem;color:var(--ink-soft)}
  .g-tit{font-family:var(--serif);font-size:clamp(1.3rem,2.2vw,1.8rem);font-weight:300;line-height:1.25;transition:color .2s}
  .guias li a:hover .g-tit{color:var(--teal)}

  /* App */
  .app{position:relative;min-height:620px;display:flex;align-items:center;overflow:hidden}
  .app > img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .app-card{position:relative;margin-left:auto;margin-right:max(32px,calc((100vw - 1240px)/2 + 32px));background:rgba(255,255,255,.88);backdrop-filter:blur(10px);padding:48px;max-width:460px}
  .app-card h2{margin-bottom:16px}
  .app-card p{color:var(--ink-soft);margin-bottom:28px}

  @media(max-width:900px){
    .hero{min-height:auto;flex-direction:column;align-items:stretch}
    .hero-img{position:relative;height:56vh;animation:none}
    .hero-in{padding-top:0}
    .hero-copy{padding:36px 0 56px}
    .manifesto{padding:72px 22px}
    .hoy{padding:64px 0}
    .hoy-in{grid-template-columns:1fr;gap:24px}
    :global(.ph-res){grid-template-columns:1fr;gap:24px}
    :global(.ph-form input){min-width:0;flex:1}
    .leer-in,.pasos{grid-template-columns:1fr;gap:44px;padding-top:72px;padding-bottom:72px}
    .pasos-img{order:-1}
    .reglas{padding:72px 0}
    .reglas ul{grid-template-columns:1fr 1fr}
    .notes{grid-template-columns:1fr}
    .guias{padding-top:72px;padding-bottom:72px}
    .guias li a{grid-template-columns:1fr;gap:4px}
    .app{min-height:auto;flex-direction:column}
    .app > img{position:relative;height:300px}
    .app-card{margin:0;max-width:none;padding:36px 22px;background:var(--white)}
  }
  @media(max-width:560px){.reglas ul{grid-template-columns:1fr}}
</style>
