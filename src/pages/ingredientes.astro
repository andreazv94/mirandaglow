---
import Layout from '../layouts/Layout.astro';
import LectorIngredientes from '../components/LectorIngredientes.tsx';
import { ingredientes } from '../data/ingredientes';
---
<Layout
  title="Lector de ingredientes — Miranda Glow"
  description="Pega la lista de ingredientes de cualquier crema o sérum y te explicamos qué lleva, para qué sirve cada cosa y qué conviene vigilar."
>
  <section class="lector wrap">
    <header class="lector-head">
      <h1>¿Qué lleva tu crema?</h1>
      <p>Haz una foto a la lista de ingredientes y te decimos en segundos qué hace y qué conviene vigilar.</p>
      <p class="small">Conocemos {ingredientes.length} ingredientes. <a href="/ingredientes/todos">Ver todos de la A a la Z</a>.</p>
    </header>
    <LectorIngredientes client:load />
  </section>
</Layout>

<style is:global>
  .lector{max-width:960px;padding-top:56px;padding-bottom:96px}
  .lector-head{margin-bottom:32px;max-width:640px}
  .lector-head h1{margin-bottom:14px}
  .lector-head p{font-family:var(--serif);font-size:1.2rem;line-height:1.5;color:var(--ink-soft);margin-bottom:8px}
  .lector-head .small{font-family:var(--sans);font-size:.88rem}

  .lx-form{background:var(--white);border:1px solid var(--line);border-radius:22px;padding:28px}
  .lx-entrada{display:grid;gap:12px}
  .lx-foto{display:flex;flex-direction:column;align-items:center;gap:6px;width:100%;padding:34px 20px;border:2px dashed var(--aqua);border-radius:18px;background:var(--mist);cursor:pointer;font:inherit;color:var(--ink)}
  .lx-foto:hover{border-color:var(--teal)}
  .lx-foto b{font-size:1.15rem;font-weight:600}
  .lx-foto small{color:var(--ink-soft);font-size:.9rem}
  .lx-cam{width:46px;height:36px;border:2.5px solid var(--teal);border-radius:9px;position:relative;margin-bottom:6px}
  .lx-cam::before{content:'';position:absolute;width:14px;height:14px;border:2.5px solid var(--teal);border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}
  .lx-cam::after{content:'';position:absolute;width:12px;height:5px;background:var(--teal);border-radius:2px 2px 0 0;left:8px;top:-7px}
  .lx-bar{height:4px;background:var(--line);border-radius:4px;overflow:hidden}
  .lx-bar i{display:block;height:100%;background:var(--teal);transition:width .3s}
  .lx-err{color:var(--ambar);font-size:.92rem}
  .lx-alt{display:flex;gap:20px;justify-content:center;flex-wrap:wrap}
  .lx-link{background:none;border:none;color:var(--teal);font:inherit;font-size:.95rem;text-decoration:underline;cursor:pointer}
  .lx-texto{margin-top:18px;display:grid;gap:10px}
  .lx-texto label{font-weight:600;font-size:.95rem}
  .lx textarea{width:100%;font:inherit;font-size:.95rem;line-height:1.5;color:var(--ink);background:var(--pearl);border:1px solid var(--line);border-radius:12px;padding:12px 14px;resize:vertical}
  .lx-texto .btn{justify-self:start}
  .lx-texto .btn[disabled]{opacity:.4}
  .lx-chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}
  .lx-chips span{font-size:.9rem;color:var(--ink-soft);margin-right:4px}
  .lx-chips label{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;font-size:.92rem;cursor:pointer;user-select:none}
  .lx-chips label.on{background:var(--ink);color:#fff;border-color:var(--ink)}
  .lx-chips input{position:absolute;opacity:0;width:1px;height:1px}
  .lx-chips label:focus-within{outline:2px solid var(--teal);outline-offset:2px}

  .lx-res{margin-top:40px;scroll-margin-top:16px}
  .lx-ver{display:flex;gap:22px;align-items:center;border-radius:22px;padding:26px 28px;margin-bottom:16px;background:var(--white);border:1px solid var(--line)}
  .lx-ver h2{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:4px}
  .lx-ver p{color:var(--ink-soft)}
  .lx-luz{display:flex;flex-direction:column;gap:6px;background:var(--ink);padding:9px;border-radius:14px;flex:none}
  .lx-luz i{width:18px;height:18px;border-radius:50%;background:#3E5257}
  .lx-v-rojo .lx-luz i:nth-child(1){background:#E0606F;box-shadow:0 0 12px #E0606F}
  .lx-v-naranja .lx-luz i:nth-child(2){background:#E8A54B;box-shadow:0 0 12px #E8A54B}
  .lx-v-verde .lx-luz i:nth-child(3){background:#55B98A;box-shadow:0 0 12px #55B98A}
  .lx-mini{position:relative;flex:none;width:92px;height:92px;border-radius:16px;overflow:hidden;display:block;box-shadow:0 2px 10px rgba(34,54,58,.15)}
  .lx-mini img{width:100%;height:100%;object-fit:cover;display:block}
  .lx-luz-s{position:absolute;right:6px;bottom:6px;flex-direction:row;gap:4px;padding:5px 6px;border-radius:10px}
  .lx-luz-s i{width:10px;height:10px}
  .lx-priv{display:block;margin-top:8px;font-size:.82rem;color:var(--ink-soft)}
  .lx-piel{background:var(--white);border:1px solid var(--line);border-radius:22px;padding:24px 26px;margin-bottom:16px;border-left:6px solid var(--line)}
  .lx-p-bien{border-left-color:#55B98A}
  .lx-p-matices{border-left-color:#E8A54B}
  .lx-p-corta{border-left-color:#E0606F}
  .lx-piel-cab{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between}
  .lx-piel h3{font-family:var(--serif);font-weight:400;font-size:clamp(1.35rem,2.6vw,1.7rem);margin:0}
  .lx-seg{display:inline-flex;background:var(--mist);border-radius:999px;padding:4px}
  .lx-seg button{border:0;background:none;font:inherit;font-size:.9rem;padding:7px 14px;border-radius:999px;cursor:pointer;color:var(--ink)}
  .lx-seg button.on{background:var(--ink);color:#fff}
  .lx-seg button:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
  .lx-textura{margin:12px 0 0;color:var(--ink-soft);font-size:.95rem}
  .lx-textura a{color:var(--teal)}
  .lx-puntos{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px}
  .lx-puntos li{display:flex;gap:12px;align-items:flex-start;line-height:1.45}
  .lx-puntos i{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-weight:700;font-size:.8rem;margin-top:1px}
  .lx-puntos .si i{background:#DDF1E7;color:#2E8A5F}
  .lx-puntos .ojo i{background:#FBEBD3;color:#B06F12}

  .lx-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .lx-col{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:20px 20px 16px;border-top:4px solid}
  .lx-verde{border-top-color:#55B98A}.lx-naranja{border-top-color:#E8A54B}.lx-rojo{border-top-color:#E0606F}
  .lx-col h3{font-family:var(--sans);font-size:1rem;font-weight:700;margin-bottom:12px;letter-spacing:0}
  .lx-col ul{list-style:none;display:grid;gap:12px}
  .lx-col li b{display:block;font-size:.95rem}
  .lx-col li span{display:block;font-size:.88rem;color:var(--ink-soft)}
  .lx-col li small{display:block;font-size:.8rem;color:var(--ink);margin-top:2px}
  .lx-vacio{font-size:.9rem;color:var(--ink-soft)}

  .lx-det{margin-top:24px;background:var(--white);border:1px solid var(--line);border-radius:18px;padding:4px 22px}
  .lx-det summary{cursor:pointer;padding:16px 0;font-weight:600}
  .lx-tabla{list-style:none;border-top:1px solid var(--line);margin-bottom:10px}
  .lx-tabla li{display:grid;grid-template-columns:36px 1fr;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}
  .lx-tabla li:last-child{border-bottom:none}
  .lx-pos{font-family:var(--serif);font-size:1.15rem;color:var(--teal)}
  .lx-n{font-weight:600;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}
  .lx-n a{color:var(--teal)}
  .lx-tipo{font-weight:400;font-size:.82rem;color:var(--ink-soft)}
  .lx-que{color:var(--ink-soft);font-size:.93rem}
  .lx-desc .lx-n{color:var(--ink-soft);font-weight:500}
  .lx-nota{margin-top:18px;font-size:.84rem;color:var(--ink-soft)}

  @media(max-width:760px){
    .lx-cols{grid-template-columns:1fr}
    .lx-form{padding:18px}
    .lx-ver{padding:20px}
  }
</style>
