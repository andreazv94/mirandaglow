---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

// Recopila las necesidades y tipos de piel presentes, para los botones de filtro
const necesidades = [...new Set(posts.map((p) => p.data.concern).filter(Boolean))] as string[];
const tiposPiel = [...new Set(posts.flatMap((p) => p.data.tipoPiel || []))];
const tipoLabel: Record<string, string> = { seca: 'Piel seca', grasa: 'Piel grasa', mixta: 'Piel mixta', normal: 'Piel normal', sensible: 'Piel sensible' };
---
<Layout title="Guías de cuidado de la piel — Miranda Glow" description="Guías sobre rutinas, ingredientes y problemas de la piel, explicadas sin marcas ni publicidad.">
  <section class="blog-index wrap">
    <header class="bi-head">
      <h1>Guías</h1>
      <p>Rutinas, ingredientes y problemas de la piel explicados con calma. Cada guía dice cuándo hace falta ir a la dermatóloga.</p>
    </header>

    <div class="filtros" aria-label="Filtrar guías">
      <div class="filtro-grupo">
        <span class="filtro-label">Tema</span>
        <button class="fbtn activo" data-tipo="concern" data-val="todos">Todos</button>
        {necesidades.map((n) => <button class="fbtn" data-tipo="concern" data-val={n}>{n}</button>)}
      </div>
      <div class="filtro-grupo">
        <span class="filtro-label">Tipo de piel</span>
        <button class="fbtn activo" data-tipo="piel" data-val="todos">Todas</button>
        {tiposPiel.map((t) => <button class="fbtn" data-tipo="piel" data-val={t}>{tipoLabel[t] || t}</button>)}
        <button class="fbtn" data-tipo="natural" data-val="si" style="display:none">Naturales</button>
      </div>
    </div>

    <ul class="posts" id="posts">
      {posts.map((post) => (
        <li
          class="post-card"
          data-concern={post.data.concern || ''}
          data-piel={(post.data.tipoPiel || []).join(',')}
          data-natural={post.data.natural ? 'si' : 'no'}
        >
          <a href={`/blog/${post.slug}`}>
            <span class="tag">{post.data.concern}</span>
            <span class="pc-main">
              <h2>{post.data.titulo}</h2>
              <p>{post.data.descripcion}</p>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="sin-resultados" id="sinResultados" style="display:none">Todavía no hay guías con esos dos filtros. Prueba a quitar uno.</p>
  </section>
</Layout>

<script>
  // Filtrado en cliente. Cada botón fija el filtro de su grupo (necesidad / piel)
  // y mostramos solo las tarjetas que cumplan ambos.
  let filtro = { concern: 'todos', piel: 'todos', natural: 'todos' };

  function aplicar() {
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    let visibles = 0;
    cards.forEach((c) => {
      const okConcern = filtro.concern === 'todos' || c.dataset.concern === filtro.concern;
      const pieles = (c.dataset.piel || '').split(',');
      const okPiel = filtro.piel === 'todos' || pieles.includes(filtro.piel);
      const okNatural = filtro.natural === 'todos' || c.dataset.natural === 'si';
      const show = okConcern && okPiel && okNatural;
      c.style.display = show ? '' : 'none';
      if (show) visibles++;
    });
    const sr = document.getElementById('sinResultados');
    if (sr) sr.style.display = visibles === 0 ? 'block' : 'none';
  }

  document.querySelectorAll<HTMLElement>('.fbtn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tipo = btn.dataset.tipo as 'concern' | 'piel' | 'natural';
      const val = btn.dataset.val || 'todos';
      filtro[tipo] = val;
      // marca el botón activo dentro de su grupo
      btn.parentElement?.querySelectorAll('.fbtn').forEach((b) => b.classList.remove('activo'));
      btn.classList.add('activo');
      aplicar();
    });
  });
</script>

<style>
  .blog-index{padding-top:64px;padding-bottom:64px}
  .bi-head{max-width:640px;margin-bottom:40px}
  .bi-head h1{margin-bottom:14px}
  .bi-head p{font-family:var(--font-read);font-size:1.15rem;color:var(--ink-soft);line-height:1.6}
  .filtros{display:flex;flex-direction:column;gap:12px;margin-bottom:28px}
  .filtro-grupo{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .filtro-label{font-size:.9rem;color:var(--ink-soft);min-width:100px}
  .fbtn{background:var(--white);border:1px solid var(--line);color:var(--ink);padding:7px 13px;border-radius:var(--radius);font-size:.9rem;cursor:pointer;font-family:inherit}
  .fbtn:hover{border-color:var(--ink)}
  .fbtn.activo{background:var(--ink);color:var(--white);border-color:var(--ink)}
  .posts{list-style:none;border-top:1px solid var(--line)}
  .post-card a{display:grid;grid-template-columns:150px 1fr;gap:24px;padding:26px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}
  .post-card a:hover h2{color:var(--lila)}
  .tag{font-size:.9rem;color:var(--ink-soft);padding-top:3px}
  .pc-main h2{font-size:1.3rem;letter-spacing:-.015em;margin-bottom:6px}
  .pc-main p{font-family:var(--font-read);color:var(--ink-soft);max-width:68ch;line-height:1.55}
  .sin-resultados{color:var(--ink-soft);margin-top:30px}
  @media(max-width:700px){.post-card a{grid-template-columns:1fr;gap:4px}.filtro-label{min-width:0;width:100%}}
</style>
