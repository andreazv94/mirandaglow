---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Genera una página estática por cada .mdx de src/content/blog
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const minutos = Math.max(2, Math.round((post.body || '').split(/\s+/).length / 220));
---
<Layout title={`${post.data.titulo} — Miranda Glow`} description={post.data.descripcion}>
  <article class="article wrap">
    <header class="art-head">
      {post.data.concern && <a class="tag" href="/blog">{post.data.concern}</a>}
      <h1>{post.data.titulo}</h1>
      <p class="art-desc">{post.data.descripcion}</p>
      <time>Actualizado el {post.data.fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    </header>
    {post.data.claves && (
      <aside class="claves" aria-label="En 30 segundos">
        <p class="claves-t">En 30 segundos <span>· {minutos} min de lectura completa</span></p>
        <ul>{post.data.claves.map((c) => <li>{c}</li>)}</ul>
      </aside>
    )}
    {post.data.video ? (
      <video class="art-video" src={`/video/${post.data.video}.mp4`} poster={`/video/${post.data.video}.jpg`} controls playsinline muted preload="none"></video>
    ) : post.data.imagen && <img class="art-img" src={post.data.imagen} alt="" />}
    <div class="prose">
      <Content />
    </div>

    <aside class="art-cta">
      <h3>¿Quieres una rutina hecha para tu piel?</h3>
      <p>Responde unas diez preguntas y te decimos qué usar, en qué orden y qué evitar.</p>
      <a class="btn" href="/test">Hacer el test de piel</a>
    </aside>
  </article>
</Layout>

<style>
  .article{max-width:740px;padding-top:56px;padding-bottom:72px}
  .art-head{margin-bottom:40px;padding-bottom:28px;border-bottom:1px solid var(--line)}
  .tag{display:inline-block;font-size:.92rem;color:var(--acento);text-decoration:none;margin-bottom:14px}
  .tag:hover{text-decoration:underline}
  .art-head h1{font-size:clamp(2rem,4.4vw,2.9rem);margin-bottom:16px}
  .art-desc{font-family:var(--font-read);font-size:1.2rem;color:var(--ink-soft);line-height:1.55;margin-bottom:16px}
  .art-head time{font-size:.88rem;color:var(--ink-soft)}
  .art-img{width:calc(100% + 120px);max-width:none;margin:-8px -60px 48px;aspect-ratio:16/9;object-fit:cover;border-radius:4px}
  @media(max-width:860px){.art-img{width:100%;margin:-8px 0 36px}}
  .prose :global(table){width:100%;border-collapse:collapse;font-family:var(--sans);font-size:.95rem;margin:24px 0 28px}
  .prose :global(th){text-align:left;font-weight:600;border-bottom:2px solid var(--ink);padding:10px 12px 10px 0}
  .prose :global(td){border-bottom:1px solid var(--line);padding:12px 12px 12px 0;vertical-align:top;color:#33494D}
  .art-video{display:block;width:100%;max-width:560px;margin:-8px auto 44px;aspect-ratio:1;border-radius:18px;background:var(--mist)}
  .claves{background:var(--mist);border-radius:18px;padding:24px 28px;margin:0 0 44px;font-family:var(--sans)}
  .claves-t{font-weight:700;font-size:1.05rem;margin-bottom:12px}
  .claves-t span{font-weight:400;color:var(--ink-soft);font-size:.9rem}
  .claves ul{list-style:none;display:grid;gap:10px}
  .claves li{position:relative;padding-left:26px;font-size:1.02rem;line-height:1.5;color:var(--ink)}
  .claves li::before{content:'';position:absolute;left:2px;top:.45em;width:12px;height:12px;border-radius:50%;background:var(--teal)}
  .prose{font-family:var(--font-read);font-size:1.13rem;line-height:1.75;color:#33494D}
  .prose :global(h2){font-family:var(--serif);font-weight:400;font-size:1.9rem;letter-spacing:-.01em;line-height:1.15;margin:48px 0 14px;color:var(--ink)}
  .prose :global(h3){font-family:var(--sans);font-weight:600;font-size:1.05rem;margin:32px 0 10px;color:var(--ink)}
  .prose :global(p){margin-bottom:20px}
  .prose :global(ul),.prose :global(ol){margin:0 0 22px 24px}
  .prose :global(li){margin-bottom:8px}
  .prose :global(strong){color:var(--ink);font-weight:600}
  .prose :global(blockquote){border-left:3px solid var(--ambar);background:#FBF5EC;padding:14px 18px;margin:26px 0;font-size:1.02rem}
  .prose :global(blockquote p){margin:0}
  .art-cta{margin-top:56px;border:1px solid var(--line);background:var(--white);border-radius:var(--radius);padding:32px}
  .art-cta h3{font-size:1.7rem;margin-bottom:8px}
  .art-cta p{color:var(--ink-soft);margin-bottom:20px}
</style>
