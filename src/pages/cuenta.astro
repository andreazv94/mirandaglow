---
import Layout from '../layouts/Layout.astro';
import Cuenta from '../components/Cuenta.tsx';
---
<Layout noindex title="Mi cuenta — Miranda Glow" description="Tu piel, tu ciclo y tus cremas, guardados en tu móvil o en tu cuenta.">
  <section class="wrap cuenta">
    <header class="cuenta-head">
      <h1>Mi cuenta</h1>
      <p>Tu piel, tu ciclo y las cremas que tienes en casa, en un solo sitio.</p>
    </header>
    <Cuenta client:load />
  </section>
</Layout>

<style is:global>
  .cuenta{padding-top:56px;padding-bottom:96px;max-width:880px}
  .cuenta-head h1{font-size:clamp(2.6rem,6vw,4.2rem);margin:0 0 10px}
  .cuenta-head p{font-family:var(--serif);font-size:1.2rem;color:var(--ink-soft);margin:0 0 36px}
  .cu-cargando{color:var(--ink-soft)}
  .cu{display:grid;gap:18px}
  .cu h2{font-family:var(--serif);font-weight:400;font-size:clamp(1.5rem,3vw,1.9rem);margin:0 0 10px}
  .cu-caja,.cu-sec,.cu-op,.cu-hola{background:var(--white);border:1px solid var(--line);border-radius:22px;padding:26px 28px}
  .cu-centro{text-align:center;max-width:460px;margin:0 auto}
  .cu-centro p{color:var(--ink-soft);margin-bottom:20px}
  .cu-aviso{margin:0;padding:14px 18px;border-radius:14px;font-size:.95rem}
  .cu-ok{background:#DDF1E7;color:#1F5E40}
  .cu-error{background:#FBE3E6;color:#8A2433}
  .cu-hola{display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap}
  .cu-hola p{margin:0;color:var(--ink-soft)}
  .cu-opciones{display:grid;grid-template-columns:1fr 1.5fr;gap:18px}
  @media (max-width:760px){.cu-opciones{grid-template-columns:1fr}}
  .cu-op p{color:var(--ink-soft);line-height:1.55}
  .cu-op-cuenta{border-color:var(--aqua);box-shadow:0 0 0 3px var(--mist)}
  .cu-consent{display:flex;gap:12px;align-items:flex-start;background:var(--pearl);border-radius:14px;padding:14px 16px;font-size:.9rem;line-height:1.5;cursor:pointer;margin-top:6px}
  .cu-consent input{width:20px;height:20px;flex:none;margin-top:2px;accent-color:var(--teal)}
  .cu-consent a,.cu-link{color:var(--teal)}
  .cu-nota{font-size:.85rem;color:var(--ink-soft);margin:8px 0 0}
  .cu-google{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:18px;padding:13px 20px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);text-decoration:none;font-weight:500;transition:border-color .2s}
  .cu-google:hover{border-color:var(--ink)}
  .cu-google svg{width:20px;height:20px}
  .cu-email{margin-top:18px}
  .cu-email label{display:block;font-size:.9rem;color:var(--ink-soft);margin-bottom:8px}
  .cu-email div{display:flex;gap:10px;flex-wrap:wrap}
  .cu-email input,.cu-ciclo-form input{font:inherit;padding:12px 16px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink)}
  .cu-email input{flex:1 1 200px}
  .cu input:focus-visible,.cu button:focus-visible,.cu a:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
  .cu-link{background:none;border:0;padding:0;font:inherit;font-size:.92rem;text-decoration:underline;cursor:pointer}
  .cu-intro{color:var(--ink-soft);margin:0 0 16px;line-height:1.55}
  .cu-dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:6px 0 20px}
  .cu-dl div{background:var(--pearl);border-radius:14px;padding:12px 16px}
  .cu-dl dt{font-size:.8rem;color:var(--ink-soft);margin-bottom:2px}
  .cu-dl dd{margin:0;font-weight:500}
  .cu-acciones{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .cu-vacio p{color:var(--ink-soft);margin:0 0 16px}
  .cu-fase{border-radius:18px;padding:20px 22px;margin-bottom:18px;background:var(--mist)}
  .cu-f-menstrual{background:var(--blush)}
  .cu-fase h3{font-family:var(--serif);font-weight:400;font-size:1.5rem;margin:2px 0 8px}
  .cu-fase p{margin:0 0 8px;line-height:1.5}
  .cu-dia{font-size:.85rem;color:var(--ink-soft)}
  .cu-ciclo-form{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-end}
  .cu-ciclo-form label{display:grid;gap:6px;font-size:.9rem;color:var(--ink-soft)}
  .cu-num{display:flex;align-items:center;gap:8px;color:var(--ink)}
  .cu-num input{width:84px}
  .cu-cremas{list-style:none;margin:0;padding:0;display:grid}
  .cu-cremas li{display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid var(--line)}
  .cu-cremas li:first-child{border-top:0}
  .cu-cremas li > div{flex:1;min-width:0}
  .cu-cremas b{display:block}
  .cu-cremas small{color:var(--ink-soft)}
  .cu-cremas a{color:var(--teal);font-size:.92rem;white-space:nowrap}
  .cu-luz{width:14px;height:14px;border-radius:50%;flex:none;background:#C9D3D4}
  .cu-luz-verde{background:#55B98A}.cu-luz-naranja{background:#E8A54B}.cu-luz-rojo{background:#E0606F}
  .cu-datos p{color:var(--ink-soft);margin:0 0 16px}
  .cu-peligro{color:#A3283A;border-color:rgba(163,40,58,.4)}
  .cu-confirmar{display:inline-flex;gap:12px;align-items:center;flex-wrap:wrap}
  .cu-rojo{background:#B3263B;border-color:#B3263B}
  .cu-rojo:hover{background:#8A1D2D;border-color:#8A1D2D}
  @media (max-width:520px){.cu-caja,.cu-sec,.cu-op,.cu-hola{padding:22px 20px}}
</style>
