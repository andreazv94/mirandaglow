---
import Layout from '../../layouts/Layout.astro';
import { analisis, analisisPorSlug } from '../../data/analisis';
import { analizarLista, tipoTxt } from '../../data/ingredientes';
import { fichaDeInci } from '../../data/fichas';
import { paraTuPiel } from '../../lib/paraTuPiel';
import { articulo, migas } from '../../lib/seo';

export function getStaticPaths() {
  return analisis.map((a) => ({ params: { slug: a.slug } }));
}

const a = analisisPorSlug(Astro.params.slug!)!;
const filas = analizarLista(a.inci).map((f, i) => ({ pos: i + 1, ...f }));
const conocidos = filas.filter((f) => f.ing);

// Veredicto para cada tipo de piel, con el mismo cálculo que el lector
const perfiles = [
  { t: 'Piel seca', r: paraTuPiel(filas, 'seca') },
  { t: 'Piel normal', r: paraTuPiel(filas, 'normal') },
  { t: 'Piel mixta', r: paraTuPiel(filas, 'mixta') },
  { t: 'Piel grasa', r: paraTuPiel(filas, 'grasa') },
  { t: 'Piel sensible', r: paraTuPiel(filas, null, { sensible: true }) },
  { t: 'Piel atópica', r: paraTuPiel(filas, null, { atopica: true }) },
  { t: 'Con granitos', r: paraTuPiel(filas, null, { granitos: true }) },
];
const palabra = { bien: 'Le va bien', matices: 'Con matices', corta: 'No es lo ideal' };
const textura = perfiles[0].r?.textura;

const perfume = conocidos.filter((f) => f.ing!.tipo === 'perfume' || f.ing!.alergeno).map((f) => f.ing!.n);
const embarazo = conocidos.filter((f) => f.ing!.embarazo);
const otros = alrededor();
function alrededor() {
  return analisis.filter((x) => x.slug !== a.slug).slice(0, 3);
}
const fecha = new Date(a.comprobado + 'T12:00:00');
const fechaTxt = fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const titulo = `${a.nombre}: ingredientes analizados y para qué piel es`;
const enLector = `/ingredientes?lista=${encodeURIComponent(a.inci)}`;
---
<Layout
  title={`${titulo} — Miranda Glow`}
  description={a.resumen}
  type="article"
  image={a.imagen}
  jsonld={[
    articulo({ titulo, descripcion: a.resumen, ruta: `/analisis/${a.slug}`, fecha, imagen: a.imagen, seccion: 'Análisis de cremas' }),
    migas([['Inicio', '/'], ['Análisis de cremas', '/analisis'], [a.nombre, `/analisis/${a.slug}`]]),
  ]}
>
  <article class="an wrap">
    <a class="volver" href="/analisis">Todos los análisis</a>
    <header class="an-head">
      <p class="an-tipo">{a.tipo} · {a.marca}</p>
      <h1>{a.nombre}: qué lleva y para qué piel es</h1>
      <p class="an-res">{a.resumen}</p>
      <p class="an-meta">{filas.length} ingredientes · Lista comprobada el {fechaTxt} · Análisis independiente: ninguna marca nos paga.</p>
    </header>

    <aside class="claves" aria-label="En 30 segundos">
      <p class="claves-t">En 30 segundos</p>
      <ul>{a.claves.map((c) => <li>{c}</li>)}</ul>
    </aside>

    <section class="an-sec">
      <h2>¿Para qué piel es?</h2>
      {textura && <p class="an-intro">{textura}</p>}
      <ul class="an-pieles">
        {perfiles.map(({ t, r }) => r && (
          <li class={`p-${r.tono}`}>
            <b>{t}</b>
            <span class="an-badge">{palabra[r.tono]}</span>
            <p>{r.puntos.filter((x) => !x.ok)[0]?.t || r.puntos[0]?.t}</p>
          </li>
        ))}
      </ul>
      {(perfume.length > 0 || embarazo.length > 0) && (
        <div class="an-avisos">
          {perfume.length > 0 && <p><b>Perfume:</b> lleva {perfume.join(', ')}.</p>}
          {embarazo.length > 0 && <p><b>Embarazo:</b> lleva {embarazo.map((f) => f.ing!.n).join(', ')}. Consulta con tu médica.</p>}
        </div>
      )}
      <p class="an-tu"><a class="btn" href={enLector}>Ver cómo le sienta a tu piel</a> <a class="btn ghost" href={`/comparar?a=${a.slug}`}>Compararla con otra</a></p>
    </section>

    <div class="an-dos">
      <section class="an-sec">
        <h2>Lo bueno</h2>
        <ul class="an-lista si">{a.bueno.map((x) => <li>{x}</li>)}</ul>
      </section>
      <section class="an-sec">
        <h2>Lo mejorable</h2>
        <ul class="an-lista ojo">{a.mejorable.map((x) => <li>{x}</li>)}</ul>
      </section>
    </div>

    <section class="an-sec">
      <h2>Cómo usarla</h2>
      <ul class="an-lista">{a.comoUsar.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="an-sec">
      <h2>Ingrediente por ingrediente</h2>
      <p class="an-intro">Van de más a menos cantidad. A partir del 1 % la marca puede ordenarlos como quiera.</p>
      <ol class="an-ings">
        {filas.map((f) => {
          const ficha = f.ing && fichaDeInci(f.ing.n);
          return (
            <li class={f.ing && (f.ing.tipo === 'perfume' || f.ing.alergeno) ? 'perf' : ''}>
              <span class="n">{f.pos}</span>
              <div>
                <p class="nom">
                  {ficha ? <a href={`/ingredientes/${ficha.slug}`}>{f.texto}</a> : f.texto}
                  {f.ing && <span class="t">{tipoTxt[f.ing.tipo]}</span>}
                </p>
                {f.ing && <p class="que">{f.ing.que}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="an-sec an-fuente">
      <h2>De dónde sale esta lista</h2>
      <ul>{a.fuentes.map((f) => <li><a href={f.url} rel="nofollow noopener" target="_blank">{f.texto}</a></li>)}</ul>
      {a.nota && <p>{a.nota}</p>}
      <p>Comprobada el {fechaTxt}. Las marcas cambian sus fórmulas: compara siempre con la lista de tu envase. Este análisis es orientativo y no sustituye a tu dermatóloga.</p>
      {a.comprar && <p><a class="btn ghost" href={a.comprar} rel="sponsored nofollow noopener" target="_blank">Ver precio</a> <small>Enlace de afiliado: si compras, nos llevamos una pequeña comisión.</small></p>}
    </section>

    <nav class="an-mas" aria-label="Más análisis">
      <h2>Más análisis</h2>
      <ul>
        {otros.map((x) => <li><a href={`/analisis/${x.slug}`}><span>{x.tipo}</span>{x.nombre}</a></li>)}
      </ul>
    </nav>
  </article>
</Layout>

<style>
  .an{max-width:820px;padding-top:40px;padding-bottom:96px}
  .volver{font-size:.9rem;color:var(--teal)}
  .an-head{margin:22px 0 28px}
  .an-tipo{font-size:.9rem;color:var(--teal);margin:0 0 10px}
  .an-head h1{font-size:clamp(2rem,4.6vw,3rem);margin:0 0 14px}
  .an-res{font-family:var(--serif);font-size:1.25rem;line-height:1.5;color:var(--ink-soft);margin:0 0 12px}
  .an-meta{font-size:.85rem;color:var(--ink-soft);margin:0}
  .claves{background:var(--mist);border-radius:20px;padding:22px 26px;margin-bottom:34px}
  .claves-t{font-weight:600;margin:0 0 10px}
  .claves ul{margin:0;padding-left:1.1em;line-height:1.6}
  .an-sec{margin-bottom:40px}
  .an-sec h2{font-size:1.6rem;margin:0 0 12px}
  .an-intro{color:var(--ink-soft);margin:0 0 16px}
  .an-pieles{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
  .an-pieles li{background:var(--white);border:1px solid var(--line);border-left:5px solid var(--line);border-radius:16px;padding:14px 16px}
  .an-pieles .p-bien{border-left-color:#55B98A}.an-pieles .p-matices{border-left-color:#E8A54B}.an-pieles .p-corta{border-left-color:#E0606F}
  .an-pieles b{display:block}
  .an-badge{display:inline-block;font-size:.78rem;margin:4px 0 6px;padding:2px 10px;border-radius:999px;background:var(--pearl)}
  .p-bien .an-badge{background:#DDF1E7;color:#1F5E40}.p-matices .an-badge{background:#FBEBD3;color:#7A4A08}.p-corta .an-badge{background:#FBE3E6;color:#8A2433}
  .an-pieles p{margin:0;font-size:.9rem;color:var(--ink-soft);line-height:1.45}
  .an-avisos{margin-top:14px;background:#FBF3E6;border-radius:14px;padding:12px 16px;font-size:.92rem}
  .an-avisos p{margin:4px 0}
  .an-tu{margin-top:18px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
  .an-tu span{font-size:.9rem;color:var(--ink-soft)}
  .an-dos{display:grid;grid-template-columns:1fr 1fr;gap:0 32px}
  @media (max-width:720px){.an-dos{grid-template-columns:1fr}}
  .an-lista{padding-left:1.1em;line-height:1.6;margin:0}
  .an-lista li{margin-bottom:8px}
  .an-lista.si li::marker{color:#2E8A5F}.an-lista.ojo li::marker{color:#B06F12}
  .an-ings{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}
  .an-ings li{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
  .an-ings .n{flex:none;width:28px;color:var(--ink-soft);font-size:.85rem;padding-top:2px}
  .an-ings .nom{margin:0;font-weight:500}
  .an-ings .nom a{color:var(--teal)}
  .an-ings .t{font-weight:400;font-size:.78rem;margin-left:8px;padding:2px 8px;border-radius:999px;background:var(--mist);color:var(--ink-soft)}
  .an-ings .perf .t{background:#FBEBD3;color:#7A4A08}
  .an-ings .que{margin:2px 0 0;font-size:.9rem;color:var(--ink-soft)}
  .an-fuente{background:var(--pearl);border:1px solid var(--line);border-radius:18px;padding:20px 24px}
  .an-fuente h2{font-size:1.2rem}
  .an-fuente p,.an-fuente li{font-size:.9rem;color:var(--ink-soft)}
  .an-fuente a{color:var(--teal)}
  .an-mas h2{font-size:1.6rem;margin:0 0 14px}
  .an-mas ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
  .an-mas a{display:block;height:100%;padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:var(--white);color:var(--ink);text-decoration:none;font-family:var(--serif);font-size:1.1rem;line-height:1.3}
  .an-mas a:hover{border-color:var(--teal)}
  .an-mas span{display:block;font-family:var(--sans);font-size:.78rem;color:var(--teal);margin-bottom:6px}
</style>
