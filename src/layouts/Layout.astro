---
import Marca from '../components/Marca.astro';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Cabecera transparente encima de una foto (portada) */
  overlay?: boolean;
  /** Imagen al compartir (ruta en /public). Por defecto, /img/og.jpg */
  image?: string;
  /** 'article' en artículos y fichas */
  type?: 'website' | 'article';
  /** No mostrar en Google (cuenta, páginas privadas) */
  noindex?: boolean;
  /** Datos estructurados (schema.org) para Google */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'Miranda Glow — Lee los ingredientes de tu crema y crea tu rutina',
  overlay = false,
  description = 'Haz una foto a la etiqueta de tu crema y te decimos qué hace y si le va a tu piel. Test de piel, rutina personalizada y guía completa, sin marcas ni publicidad.',
  image = '/img/og.jpg',
  type = 'website',
  noindex = false,
  jsonld,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(image, Astro.site);
const datos = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#F4F8F8" />
  <!-- Open Graph: cómo se ve al compartir en WhatsApp, redes, etc. -->
  <meta property="og:site_name" content="Miranda Glow" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imagen} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap.xml" />
  {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <script is:inline src="/js/cuenta.js" defer></script>
  <script is:inline src="/js/videos.js" defer></script>
  <script is:inline>
    document.addEventListener('click', function (e) { document.querySelectorAll('details.menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); }); });
    document.addEventListener('DOMContentLoaded', function () { var h = document.querySelector('.topbar'); if (!h) return; var f = function () { h.classList.toggle('scrolled', scrollY > 8); }; addEventListener('scroll', f, { passive: true }); f(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('details.menu[open]').forEach(function (d) { d.removeAttribute('open'); d.querySelector('summary').focus(); }); });
  </script>
</head>
<body>
  <div class="page">
    <header class={`topbar${overlay ? ' over' : ''}`}>
      <div class="wrap">
        <nav aria-label="Principal">
          <a class="logo" href="/"><Marca /></a>
          <div class="navlinks">
            <a href="/guia" class="hide-m">Guía de la piel</a>
            <a href="/ingredientes/todos" class="nav-ing">Ingredientes</a>
            <details class="menu">
              <summary>Menú</summary>
              <div class="menu-panel">
                <div>
                  <p>Herramientas</p>
                  <a href="/test"><b>Test de piel</b><small>Tu tipo de piel y tu rutina</small></a>
                  <a href="/ingredientes"><b>Lector de ingredientes</b><small>Qué lleva tu crema</small></a>
                  <a href="/mi-rutina"><b>Mi rutina</b><small>Ordena tus productos</small></a>
                  <a href="/herramientas" class="mas">Ver todas las herramientas</a>
                </div>
                <div>
                  <p>Aprende</p>
                  <a href="/ingredientes/todos"><b>Ingredientes</b><small>De la A a la Z y los de moda</small></a>
                  <a href="/guia"><b>Guía de la piel</b><small>Empieza por aquí</small></a>
                  <a href="/analisis"><b>Cremas analizadas</b><small>Y sus alternativas baratas</small></a>
                  <a href="/blog" class="mas">Todos los artículos</a>
                </div>
                <div class="menu-pie">
                  <a href="/cuenta" data-cuenta-link>Entrar</a>
                  <a href="/app/">App</a>
                  <a href="/sobre">Quiénes somos</a>
                </div>
              </div>
            </details>
            <a href="/cuenta" data-cuenta-link class="hide-m">Entrar</a>
            <a class="btn" href="/test"><span class="hide-xs">Hacer el </span>test</a>
          </div>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer>
      <div class="wrap">
        <div class="foot-top">
          <div class="foot-marca">
            <a class="logo" href="/"><Marca /></a>
            <p>Cuidado de la piel explicado por ingredientes. Para chicas, chicos y quien sea.</p>
            <a class="btn foot-btn" href="/test">Hacer el test de piel</a>
          </div>
          <nav class="foot-cols" aria-label="Pie de página">
            <div>
              <p>Herramientas</p>
              <a href="/ingredientes">Lector de ingredientes</a>
              <a href="/mi-rutina">Mi rutina</a>
              <a href="/comparar">Comparar cremas</a>
              <a href="/diario">Diario de granitos</a>
              <a href="/sol">El sol de hoy</a>
              <a href="/lunares">Revisa tus lunares</a>
            </div>
            <div>
              <p>Aprende</p>
              <a href="/ingredientes/todos">Ingredientes</a>
              <a href="/guia">Guía de la piel</a>
              <a href="/blog">Todos los artículos</a>
              <a href="/analisis">Análisis de cremas</a>
              <a href="/alternativas">Alternativas baratas</a>
              <a href="/mitos">Mitos de la piel</a>
            </div>
            <div>
              <p>Miranda Glow</p>
              <a href="/sobre">Quiénes somos</a>
              <a href="/app/">App</a>
              <a href="/cuenta">Mi cuenta</a>
              <a href="/aviso-legal">Aviso legal</a>
              <a href="/privacidad">Privacidad</a>
              <a href="/cookies">Cookies</a>
            </div>
          </nav>
        </div>
        <p class="disc">Ninguna marca nos paga por aparecer. Esta web es informativa y no sustituye la consulta con una dermatóloga. En calidad de Afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.</p>
        <p class="foot-copy">© {new Date().getFullYear()} Miranda Glow</p>
      </div>
    </footer>
  </div>
</body>
</html>
