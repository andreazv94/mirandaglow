---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Cabecera transparente encima de una foto (portada) */
  overlay?: boolean;
}
const {
  title = 'Miranda Glow — Tu rutina de skincare, hecha para ti',
  overlay = false,
  description = 'Responde unas preguntas y recibe una rutina de cuidado facial pensada para tu piel, tu edad, tus hormonas y tus objetivos.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <!-- Open Graph para que se vea bien al compartir en redes -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <script is:inline src="/js/cuenta.js" defer></script>
</head>
<body>
  <div class="page">
    <header class={`topbar${overlay ? ' over' : ''}`}>
      <div class="wrap">
        <nav aria-label="Principal">
          <a class="logo" href="/">Miranda Glow</a>
          <div class="navlinks">
            <a href="/guia" class="hide-m">Guía de la piel</a>
            <a href="/ingredientes" class="hide-m">Ingredientes</a>
            <a href="/app/" class="hide-m">App</a>
            <a href="/sobre" class="hide-m">Quiénes somos</a>
            <a href="/cuenta" data-cuenta-link>Entrar</a>
            <a class="btn" href="/test">Hacer el test</a>
          </div>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer>
      <div class="wrap">
        <div class="foot-grid">
          <a class="logo" href="/">Miranda Glow</a>
          <div class="foot-links">
            <a href="/test">Test de piel</a>
            <a href="/guia">Guía de la piel</a>
            <a href="/blog">Todos los artículos</a>
            <a href="/ingredientes">Lector de ingredientes</a>
            <a href="/app/">App</a>
            <a href="/sobre">Quiénes somos</a>
            <a href="/cuenta">Mi cuenta</a>
            <a href="/aviso-legal">Aviso legal</a>
            <a href="/privacidad">Privacidad</a>
            <a href="/cookies">Cookies</a>
          </div>
        </div>
        <p class="disc">Ninguna marca nos paga por aparecer. Esta web es informativa y no sustituye la consulta con una dermatóloga. En calidad de Afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.</p>
      </div>
    </footer>
  </div>
</body>
</html>
